---
import { buildComposeLinks, buildDraft } from '../scripts/contact';
const emailLinks = buildComposeLinks(buildDraft());
---

<form
  class="contact-form"
  aria-labelledby="form-title"
  aria-describedby="mail-help"
  data-contact-form
>
  <p class="form-eyebrow">01 / A NEW CONVERSATION</p>
  <h2 id="form-title">
    Tell me what
    <br />
    you’re thinking.
  </h2>
  <fieldset class="form-fields" disabled>
    <legend class="sr-only">Your message</legend>
    <label>
      <span class="sr-only">Your name</span>
      <input name="name" autocomplete="name" placeholder="Your name" required maxlength="100" />
    </label>
    <label>
      <span class="sr-only">Email address</span>
      <input
        name="email"
        type="email"
        autocomplete="email"
        placeholder="Email address"
        required
        maxlength="254"
      />
    </label>
    <label class="message-field">
      <span class="sr-only">What would you like to talk about?</span>
      <textarea
        name="message"
        placeholder="What would you like to talk about?"
        required
        maxlength="2500"
        rows="3"
      ></textarea>
      <img
        class="resize-mark"
        src="/images/contact/textarea-resize-affordance-280aa.svg"
        width="11.547"
        height="11.547"
        alt=""
        aria-hidden="true"
      />
    </label>
  </fieldset>
  <button type="submit" disabled>
    Send message{' '}
    <img
      src="/images/contact/arrow-decorative-c5791.svg"
      width="26.786"
      height="21.916"
      alt=""
      aria-hidden="true"
    />
  </button>
  <p class="form-help" id="mail-help">
    Prepares an email draft. Choose Gmail, Outlook, or your email app, then review and send it
    there.
  </p>
  <noscript>
    <p>
      Email rominaveisy.ar@gmail.com using
      <a href={emailLinks.gmail} target="_blank" rel="noopener noreferrer">
        Gmail
      </a>
      ,
      <a href={emailLinks.outlook} target="_blank" rel="noopener noreferrer">
        Outlook
      </a>
      , or
      <a href="mailto:rominaveisy.ar@gmail.com">your email app</a>.
    </p>
  </noscript>
</form>
