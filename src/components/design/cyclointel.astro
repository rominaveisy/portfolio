            class="d-b9e4ea293"
          />
        </div>
        <div data-figma-id="272:73" class="d-051f5c546">
          <p data-figma-id="272:75" class="d-a2feafe27">
            V2 — DASHBOARD
          </p>
          <p data-figma-id="272:76" class="d-414ecf017">
            Five big numbers, a feed, and a competitor sidebar with trend lines. Impressive at a
            glance.
          </p>
        </div>
      </div>
    </div>
    <div data-figma-id="275:139" class="d-d55c5b1d5">
      <div data-figma-id="276:141" class="d-53cd05d2f">
