    <Contact />
  </div>
  <p class="contact-direct">
    Email{' '}
    <a href="mailto:rominaveisy.ar@gmail.com" data-email-options>
      rominaveisy.ar@gmail.com
    </a>{' '}
    <span aria-hidden="true">·</span> Phone <a href="tel:+31620435932">+31 6 2043 5932</a>
  </p>
  <ContactComposer />
</Layout>
