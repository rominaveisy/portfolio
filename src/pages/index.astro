---
import Layout from '../layouts/Layout.astro';
import Home from '../components/design/home.astro';
import CompactWheel from '../components/CompactWheel.astro';
import { projects } from '../data/projects';
import '../styles/home.css';
import '../styles/home-compact.css';
---

<Layout
  title="a creative UX/UI & visual designer"
  description="Romina Veisy is a creative UX/UI & visual designer, creating clear interfaces, interactive prototypes and visual stories for complex digital systems."
  active="work"
  home
>
  <a class="motion-skip" href="#work" data-skip-motion>
    Skip animation · View projects ↓
  </a>
  <section class="home-scroll" aria-label="Introduction and selected work">
    <div class="home-viewport">
      <div class="home-stage">
        <Home />
        <CompactWheel />
      </div>
    </div>
  </section>
  <a class="static-project-link" href="#work">
    View selected work ↓
  </a>
  <section class="project-list" id="work" aria-labelledby="work-title" tabindex="-1">
    <div class="work-list-heading">
      <p>SELECTED WORK</p>
      <h2 id="work-title">From the inside out.</h2>
    </div>
    {projects.map((project) => (
      <article class="project-card" aria-labelledby={`project-${project.slug}`}>
        <div class="project-copy">
          <p class="project-number">
            {project.number} / {project.name.toUpperCase()}
          </p>
          <h3 id={`project-${project.slug}`}>{project.title}</h3>
          <p class="project-description">{project.description}</p>
          {project.status && <p class="project-status">{project.status}</p>}
          <a class="project-cta" href={`/work/${project.slug}/`}>
            Explore this work <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="project-art">
          <img
            src={`/images/home/cards/${project.slug}-640.webp`}
            srcset={`/images/home/cards/${project.slug}-640.webp 640w, /images/home/cards/${project.slug}-1280.webp 1280w`}
            sizes="(min-width: 1400px) 600px, (min-width: 700px) 44vw, 90vw"
            alt={project.alt}
            width="700"
            height="467"
            loading="lazy"
            decoding="async"
          />
        </div>
      </article>
    ))}
  </section>
  <footer class="home-footer">
    <p>Have something in mind?</p>
    <a href="/contact/">Let’s talk ↗</a>
    <a class="footer-cv" href="/documents/romina-veisy-cv.pdf" download="Romina-Veisy-CV.pdf">
      Download CV ↗
    </a>
  </footer>
</Layout>
<script>
  import '../scripts/home-motion';
</script>
